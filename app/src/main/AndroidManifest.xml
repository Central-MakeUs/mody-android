<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 푸시 알림 표시 권한(런타임 요청 필요) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 온보딩 권한 요청 화면에서 일괄 요청(전부 선택). 카메라는 record 모듈에도 선언됨(병합). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      사진 선택은 전부 Photo Picker(PickVisualMedia) → 저장소/미디어 권한 불필요.
      미사용 권한은 스토어 정책 리젝 리스크라 제거함.
    -->

    <!--
      걸음 수는 Health Connect 로만 읽는다(기기 센서 ACTIVITY_RECOGNITION 미사용).
      Play Console 에 건강 데이터 접근 선언 + 개인정보처리방침 제출 필요.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />


    <!-- 카메라 권한이 있어도 카메라 없는 기기(일부 태블릿/ChromeOS) 설치 허용 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Android 11+ 패키지 가시성: 카카오톡 설치 여부 확인(isKakaoTalkSharingAvailable) -->
    <queries>
        <package android:name="com.kakao.talk" />
        <!-- Health Connect 제공자 앱(Android 13 이하). getSdkStatus 조회에 필요. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".ModyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mody"
        tools:targetApi="31">

        <!-- FCM 수신 서비스 -->
        <service
            android:name=".notification.ModyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- notification 페이로드가 채널 미지정으로 올 때 쓸 기본 채널/아이콘 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mody_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />

        <!--
          Firebase 자동 화면 수집 끄기. 기본값(켜짐)이면 Activity 단위로 screen_view 를 남기는데,
          이 앱은 전 화면이 MainActivity 하나라 전부 screen_class=MainActivity 로 뭉친다.
          AnalyticsLogger 가 남기는 화면 이름과 섞이면 조회수가 두 배로 부풀고 화면 구분도 안 된다.
        -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!-- 카카오 로그인 리다이렉트 처리 (scheme = kakao{네이티브키}) -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="kakao${KAKAO_NATIVE_KEY}" />
            </intent-filter>
        </activity>
    </application>

</manifest>
