<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 푸시 알림 표시 권한(런타임 요청 필요) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 온보딩 권한 요청 화면에서 일괄 요청(전부 선택). 카메라는 record 모듈에도 선언됨(병합). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      사진 선택은 전부 Photo Picker(PickVisualMedia) → 저장소/미디어 권한 불필요.
      미사용 권한은 스토어 정책 리젝 리스크라 제거함.
    -->

    <!--
      걸음 수는 Health Connect 로만 읽는다(기기 센서 ACTIVITY_RECOGNITION 미사용).
      Play Console 에 건강 데이터 접근 선언 + 개인정보처리방침 제출 필요.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!--
      광고 ID 미사용. firebase-analytics(play-services-measurement)가 라이브러리 매니페스트에서
      이 권한을 선언해 자동 병합되는데, 우리가 쓰는 건 화면 조회/이벤트 집계뿐이고 광고·
      어트리뷰션은 하지 않는다. 병합된 채로 두면 Play Console "광고 ID 사용" 선언을 '아니요'로
      낼 수 없어 출시가 차단된다(실제로 이 사유로 반려됐다).

      나중에 광고를 붙이거나 설치 기여도를 추적하게 되면 이 블록을 지우면 원복된다.
      이벤트 집계 자체는 광고 ID 없이도 그대로 동작하므로 GA 이벤트 확장은 이유가 안 된다.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- 카메라 권한이 있어도 카메라 없는 기기(일부 태블릿/ChromeOS) 설치 허용 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Android 11+ 패키지 가시성: 카카오톡 설치 여부 확인(isKakaoTalkSharingAvailable) -->
    <queries>
        <package android:name="com.kakao.talk" />
        <!-- Health Connect 제공자 앱(Android 13 이하). getSdkStatus 조회에 필요. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".ModyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mody"
        tools:targetApi="31">

        <!-- FCM 수신 서비스 -->
        <service
            android:name=".notification.ModyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- notification 페이로드가 채널 미지정으로 올 때 쓸 기본 채널/아이콘 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mody_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />

        <!--
          Firebase 자동 화면 수집 끄기. 기본값(켜짐)이면 Activity 단위로 screen_view 를 남기는데,
          이 앱은 전 화면이 MainActivity 하나라 전부 screen_class=MainActivity 로 뭉친다.
          AnalyticsLogger 가 남기는 화면 이름과 섞이면 조회수가 두 배로 부풀고 화면 구분도 안 된다.
        -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!--
          광고 ID 수집 끄기. 위에서 AD_ID 권한을 제거했으므로 SDK 가 조회해도 0 문자열만
          돌아오는데, 수집 시도 자체를 꺼야 Play Console 선언("광고 ID 사용: 아니요")과
          실제 동작이 일치한다.
        -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- 카카오 로그인 리다이렉트 처리 (scheme = kakao{네이티브키}) -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="kakao${KAKAO_NATIVE_KEY}" />
            </intent-filter>
        </activity>
    </application>

</manifest>
