<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          인증 사진 촬영 결과를 받을 임시 파일(cacheDir/challenge/camera) 공유용.

          android:name 은 모듈별 서브클래스여야 한다 — androidx.core.content.FileProvider 를
          그대로 쓰면 다른 모듈의 provider 와 이름이 겹쳐 매니페스트 병합이 실패한다.
          meta-data 는 생략 불가 — getUriForFile() 은 서브클래스 생성자가 아니라
          이 meta-data 를 읽어 경로 전략을 만든다(없으면 IllegalArgumentException).
        -->
        <provider
            android:name="com.makeus.mody.feature.challenge.util.ChallengeFileProvider"
            android:authorities="${applicationId}.challenge.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/challenge_file_paths" />
        </provider>
    </application>
</manifest>
