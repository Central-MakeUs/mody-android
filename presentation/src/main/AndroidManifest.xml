<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Mody"
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="31">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              그룹 초대 App Links: https://${inviteHost}/invite?code=XXX (debug=dev-mody.store, release=prod-mody.shop)
              autoVerify = 앱 배포 + 서버 /.well-known/assetlinks.json(릴리스 SHA-256) 서빙 시
              브라우저/카카오에서 앱 자동 열림. 미배포 동안은 검증 안 되어 브라우저 랜딩으로 폴백.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${inviteHost}"
                    android:pathPrefix="/invite" />
            </intent-filter>

            <!--
              카카오톡 공유 버튼(executionParams) 실행:
              kakao{네이티브키}://kakaolink?code=XXX
              수신자 카카오톡이 이 스킴으로 설치 여부를 판단해 앱 실행/마켓 이동을 분기한다.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="kakao${KAKAO_NATIVE_KEY}"
                    android:host="kakaolink" />
            </intent-filter>

            <!--
              Health Connect 권한 사용 근거 화면(Android 13 이하). 선언이 없으면 일부 기기에서
              권한 요청 자체가 거절된다.
              TODO(health): 현재는 앱만 열린다 — 개인정보처리방침/사용 목적 화면으로 연결 필요.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ 에서 같은 역할을 하는 진입점. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
